# Application
APP_ENV=development
ENVIRONMENT=development

# Backend
DATABASE_URL=postgresql+psycopg://zero_protocol:zero_protocol@postgres:5432/zero_protocol
CORS_ORIGINS=http://localhost:5173
DEFAULT_ORGANIZATION_ID=pulseboard
BACKEND_BASE_URL=http://backend:8000
BACKEND_URL=http://backend:8000
INTERNAL_SERVICE_KEY=replace-for-shared-environments
IMPORT_MAX_BYTES=5242880
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
POSTGRES_DB=zero_protocol
POSTGRES_USER=zero_protocol
POSTGRES_PASSWORD=zero_protocol

# Agent worker (docker compose runs agent/worker.py, which claims queued runs)
AGENT_POLL_INTERVAL_SECONDS=2
# Only for running a single decision manually with agent/main.py
AGENT_GOAL_ID=GOAL-001
AGENT_DECISION_ID=

# Agent LLM providers (optional; empty keys use the rule-based fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
